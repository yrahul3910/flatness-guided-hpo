@inproceedings{sagun_empirical_2018,
	title = {Empirical {Analysis} of the {Hessian} of {Over}-{Parametrized} {Neural} {Networks}},
	url = {http://arxiv.org/abs/1706.04454},
	doi = {10.48550/arXiv.1706.04454},
	language = {en},
	urldate = {2025-02-28},
	booktitle = {International {Conference} on {Learning} {Representations} {Workshop} {Track}},
	author = {Sagun, Levent and Evci, Utku and Guney, V. Ugur and Dauphin, Yann and Bottou, Leon},
	month = may,
	year = {2018},
	note = {arXiv:1706.04454 [cs]},
	keywords = {Computer Science - Machine Learning},
	annote = {Show that the Hessian spectra of MLP and CNNs consist of a “bulk” of near-zero eigenvalues and a few (approximately equal to \$k - 1\$ where \$k\$ is the number of classes) “outliers”. Further, they show that even at the minima attained by GD or SGD, there are a few (low-magnitude) negative eigenvalues of the Hessian, showing that training has not completed, even though the steps made are very small. They discuss how it may be better to discuss flatness via level sets rather than basins of attraction, which may be misleading.
Another (relatively minor) result is that the Hessian of deep networks is empirically observed to be low-rank.
Some of the observations are refined by “An Investigation into Neural Net Optimization via Hessian Eigenvalue Density”
},
}


